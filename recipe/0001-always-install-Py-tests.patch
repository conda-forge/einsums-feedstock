From: "Lori A. Burns" <lori.burns@gmail.com>
Date: Sun, 11 Oct 2026 15:49:33 -0400
Subject: [PATCH 1/1] always install Py tests

---
 libs/CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libs/CMakeLists.txt b/libs/CMakeLists.txt
index 825ba751..5a326d42 100644
--- a/libs/CMakeLists.txt
+++ b/libs/CMakeLists.txt
@@ -215,7 +215,7 @@ if(EINSUMS_BUILD_PYTHON OR EINSUMS_BUILD_PYTHON MATCHES "3(\.[0-9]+)*")
     COMPONENT EinsumsPy
   )
   
-  if(EINSUMS_WITH_TESTS)
+  #if(EINSUMS_WITH_TESTS)
     install(
       DIRECTORY
         ../tests
@@ -233,7 +233,7 @@ if(EINSUMS_BUILD_PYTHON OR EINSUMS_BUILD_PYTHON MATCHES "3(\.[0-9]+)*")
         ${EINSUMS_INSTALL_PYMODDIR}/einsums
       COMPONENT EinsumsPy
     )
-  endif()
+  #endif()
   
   set(CMAKE_INSTALL_DEFAULT_COMPONENT_NAME "${_old_default_comp}")
 endif()
